@page
@model AlbumCardsModel
@{
    ViewData["Title"] = "Album cards";
}
<!-- Individual pages -->
<!-- Page Album cards -->
<div class="container px-4 py-4" id="album-cards">
    <div class="d-flex flex-wrap justify-content-between p-5 rounded">

        @foreach(var album in @Model.AlbumCards)
        {
            <div class="card m-3" style="width: 18rem;">
                <img src="~/img/@album.ImageUrl" class="card-img-top" alt="...">
                <div class="card-body">
                    <h5 class="card-title">@album.Title</h5>
                    <p class="card-text">@album.Description</p>
                    <a asp-page="/AlbumCarousel" class="btn btn-primary">Go somewhere</a>
                </div>
            </div>
        }

    </div>
</div>
